" Indentation
setlocal autoindent
setlocal expandtab
setlocal shiftwidth=2
setlocal softtabstop=2

" Text formatting
setlocal textwidth=120
setlocal formatoptions+=r
setlocal formatoptions+=n
setlocal formatoptions+=t
setlocal formatoptions-=l

" Only blockquotes as comments; list indentation is handled by 'n' + 'formatlistpat'
setlocal comments=n:>

" Visual wrapping
setlocal wrap
setlocal linebreak
setlocal breakindent
setlocal breakindentopt=list:-1

setlocal spell

